# Generic ignores shared across all projects in this repo.
# Project-specific paths live in each project's own .gitignore.

# Data
*.csv
*.xlsx
*.parquet

# Secrets / credentials
.env
.env.*
*.pem
credentials*
secrets*

# Python env & caches
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/

# Jupyter notebook checkpoints
.ipynb_checkpoints/

# OS / IDE files
.DS_Store
Thumbs.db
.idea/
.vscode/
